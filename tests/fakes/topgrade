#!/usr/bin/env python3
"""Stand-in for topgrade in the tests. Behaviour comes from the JSON file in $FAKE_PLAN:
{"version": "17.12.3", "main": {"exit": 1, "summary": [["npm", "FAILED"]], "text": "...", "sleep": 0},
 "retry": {"exit": 0, "summary": [["npm", "OK"]]}, "heading": "Summary"}
Every call is appended to $FAKE_CALLS as one JSON line.
"""
import json
import os
import sys
import time

plan = json.load(open(os.environ["FAKE_PLAN"]))
with open(os.environ["FAKE_CALLS"], "a") as calls:
    calls.write(json.dumps(["topgrade"] + sys.argv[1:]) + "\n")
if sys.argv[1:] == ["--version"]:
    version_file = os.environ.get("FAKE_VERSION_FILE", "")
    version = open(version_file).read().strip() if version_file and os.path.exists(version_file) else plan.get("version", "17.12.3")
    print("topgrade " + version)
    sys.exit(0)
part = plan["retry" if "--only" in sys.argv else "main"]
print(part.get("text", "== working =="))
time.sleep(part.get("sleep", 0))
if part.get("summary") is not None:
    print("\n―― 09:12:02 - %s ――" % plan.get("heading", "Summary"))
    for label, status in part["summary"]:
        print("%s: %s" % (label, status))
sys.exit(part.get("exit", 0))
